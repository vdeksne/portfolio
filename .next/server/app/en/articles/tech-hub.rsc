c:[["$","title","0",{"children":"What Makes a Place Perfect for Software Engineers? | Viktorija Deksne Portfolio"}],["$","meta","1",{"name":"description","content":"This blog post is my deep dive into the best places to live and work as a software engineer, straight from the perspective of a Latvian coder. I’ve scoped out 11 awesome spots - Riga, Berlin, Tallinn, Austin, Lisbon, Amsterdam, Stockholm, Copenhagen, Oslo, Milan, and Barcelona—breaking down safety, economy, salary, health, and visa perks (EU citizenship rocks!). Whether I’m chasing big paychecks, chill vibes, or a mix of both, each city’s got its own flavor. It’s my guide to finding the perfect coding haven—bugs beware!"}],["$","meta","2",{"property":"og:title","content":"What Makes a Place Perfect for Software Engineers? | Viktorija Deksne Portfolio"}],["$","meta","3",{"property":"og:description","content":"This blog post is my deep dive into the best places to live and work as a software engineer, straight from the perspective of a Latvian coder. I’ve scoped out 11 awesome spots - Riga, Berlin, Tallinn, Austin, Lisbon, Amsterdam, Stockholm, Copenhagen, Oslo, Milan, and Barcelona—breaking down safety, economy, salary, health, and visa perks (EU citizenship rocks!). Whether I’m chasing big paychecks, chill vibes, or a mix of both, each city’s got its own flavor. It’s my guide to finding the perfect coding haven—bugs beware!"}],["$","meta","4",{"property":"og:image","content":"https://raw.githubusercontent.com/vdeksne/portfolio-images-2025/refs/heads/main/traveler.png"}],["$","meta","5",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","6",{"name":"twitter:title","content":"What Makes a Place Perfect for Software Engineers? | Viktorija Deksne Portfolio"}],["$","meta","7",{"name":"twitter:description","content":"This blog post is my deep dive into the best places to live and work as a software engineer, straight from the perspective of a Latvian coder. I’ve scoped out 11 awesome spots - Riga, Berlin, Tallinn, Austin, Lisbon, Amsterdam, Stockholm, Copenhagen, Oslo, Milan, and Barcelona—breaking down safety, economy, salary, health, and visa perks (EU citizenship rocks!). Whether I’m chasing big paychecks, chill vibes, or a mix of both, each city’s got its own flavor. It’s my guide to finding the perfect coding haven—bugs beware!"}],["$","meta","8",{"name":"twitter:image","content":"https://raw.githubusercontent.com/vdeksne/portfolio-images-2025/refs/heads/main/traveler.png"}]]

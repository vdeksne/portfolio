c:[["$","title","0",{"children":"Bridging the Gap - Women in Tech | Viktorija Deksne Portfolio"}],["$","meta","1",{"name":"description","content":"From a persistent pay gap - women earn 85 cents to a man’s dollar in the US and face a 17% gap in Latvia - to the glass ceiling limiting leadership roles (women hold just 29.2% of STEM jobs), inequalities in tech are real. Causes include societal norms, workplace bias, and lack of STEM encouragement for girls, compounded by imposter syndrome and “Stockholm syndrome” in toxic cultures. Yet, trailblazers like Gwynne Shotwell, Charu Jain, and Latvia’s Anna Andersone inspire us. To bridge the gap, we need fair pay, mentorship, and systemic change. Looking back to Ada Lovelace, I’m motivated to keep pushing - smart, strong women hold up the world, and together, we’ll reshape tech."}],["$","meta","2",{"property":"og:title","content":"Bridging the Gap - Women in Tech | Viktorija Deksne Portfolio"}],["$","meta","3",{"property":"og:description","content":"From a persistent pay gap - women earn 85 cents to a man’s dollar in the US and face a 17% gap in Latvia - to the glass ceiling limiting leadership roles (women hold just 29.2% of STEM jobs), inequalities in tech are real. Causes include societal norms, workplace bias, and lack of STEM encouragement for girls, compounded by imposter syndrome and “Stockholm syndrome” in toxic cultures. Yet, trailblazers like Gwynne Shotwell, Charu Jain, and Latvia’s Anna Andersone inspire us. To bridge the gap, we need fair pay, mentorship, and systemic change. Looking back to Ada Lovelace, I’m motivated to keep pushing - smart, strong women hold up the world, and together, we’ll reshape tech."}],["$","meta","4",{"property":"og:image","content":"https://raw.githubusercontent.com/vdeksne/portfolio-images-2025/refs/heads/main/girls.jpg"}],["$","meta","5",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","6",{"name":"twitter:title","content":"Bridging the Gap - Women in Tech | Viktorija Deksne Portfolio"}],["$","meta","7",{"name":"twitter:description","content":"From a persistent pay gap - women earn 85 cents to a man’s dollar in the US and face a 17% gap in Latvia - to the glass ceiling limiting leadership roles (women hold just 29.2% of STEM jobs), inequalities in tech are real. Causes include societal norms, workplace bias, and lack of STEM encouragement for girls, compounded by imposter syndrome and “Stockholm syndrome” in toxic cultures. Yet, trailblazers like Gwynne Shotwell, Charu Jain, and Latvia’s Anna Andersone inspire us. To bridge the gap, we need fair pay, mentorship, and systemic change. Looking back to Ada Lovelace, I’m motivated to keep pushing - smart, strong women hold up the world, and together, we’ll reshape tech."}],["$","meta","8",{"name":"twitter:image","content":"https://raw.githubusercontent.com/vdeksne/portfolio-images-2025/refs/heads/main/girls.jpg"}]]

# Neon Postgres (optional but recommended for upload history + future portfolio sync).
# Use the pooled connection string from the Neon dashboard (sslmode=require).
# Paste either `postgresql://…` or the full `psql 'postgresql://…'` line — both work in this app.
# Do not commit real credentials; set DATABASE_URL in this file locally or in Vercel → Environment Variables.
# DATABASE_URL=

# Email (contact form). Either variable works.
RESEND_API_KEY=
NUXT_PRIVATE_RESEND_API_KEY=

# Content admin at /admin — use a long random string; you log in with this value.
CMS_SECRET=Victory2026!

# Images uploaded from /admin: locally under public/uploads/ (ignored by git except .gitkeep).
# On Vercel, create a Blob store — this token is set automatically when the store is linked.
# BLOB_READ_WRITE_TOKEN=

# Optional Plausible analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SCRIPT=
